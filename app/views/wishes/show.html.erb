<div style="max-width: 600px; margin: 40px auto; padding: 24px; font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', sans-serif;">
  
  <div style="background: #fffcfd; border: 1.5px solid #ffe6f2; border-radius: 20px; padding: 30px; box-shadow: 0 4px 20px rgba(255,182,193,0.2);">
    
    <h2 style="color: #ff99bb; text-align: center; margin-top: 0; margin-bottom: 24px; font-weight: 700;"><%= @wish.title %></h2>

    <% if @wish.image.attached? %>
      <div style="text-align: center; margin-bottom: 20px;">
        <%= image_tag @wish.image, style: "max-width: 100%; max-height: 250px; border-radius: 12px; object-fit: cover;" %>
      </div>
    <% end %>

    <div style="background: #fff5f8; border-radius: 16px; padding: 20px; margin-bottom: 24px; color: #6d5b71; font-size: 15px;">
      <p style="margin: 8px 0;">🌟 目標金額: <strong>¥<%= number_to_currency(@wish.target_amount, unit: "", precision: 0) if @wish.target_amount.present? %></strong></p>
      <p style="margin: 8px 0;">🫧  現在の貯金: <strong>0円 (0%)</strong></p>
      <p style="margin: 8px 0;">📅 目標期限: <strong><%= @wish.deadline.strftime("%Y年%m月%d日") if @wish.deadline.present? %></strong></p>
      
      <% if @wish.link_url.present? %>
        <p style="margin: 8px 0;">🔗 リンク: <%= link_to @wish.link_url, @wish.link_url, target: "_blank", rel: "noopener", style: "color: #ff99bb;" %></p>
      <% end %>

      <% if @wish.memo.present? %>
        <p style="margin: 8px 0;">📝 メモ: <%= @wish.memo %></p>
      <% end %>
    </div>

    <!-- 💡 新しく追加した「貯金記録の入力フォーム」 -->
    <div style="background: #fff5f8; border-radius: 16px; padding: 20px; margin-bottom: 24px; color: #6d5b71;">
      <h3 style="color: #6d5b71; margin-top: 0; font-size: 18px;">💌 貯金を記録する</h3>
      
      <%= form_with(model: [@wish, @saving], local: true) do |f| %>
        
        <!-- 金額フィールド ＋ datalist -->
        <div style="margin-bottom: 12px;">
          <%= f.label :amount, "金額 (円)", style: "display: block; font-weight: bold; margin-bottom: 4px; font-size: 14px;" %>
          
          <!-- list属性で下の datalist と紐付ける -->
          <%= f.number_field :amount, placeholder: "例: 1000", list: "amount-options", style: "width: 100%; padding: 8px; border: 1px solid #ffe6f2; border-radius: 8px; box-sizing: border-box;" %>
          
          <!-- 過去の金額の候補リスト -->
          <% if @existing_amounts.present? %>
            <datalist id="amount-options">
              <% @existing_amounts.each do |amount| %>
                <option value="<%= amount %>">
              <% end %>
            </datalist>
          <% end %>
        </div>

        <div style="margin-bottom: 12px;">
          <%= f.label :saved_at, "貯金した日付", style: "display: block; font-weight: bold; margin-bottom: 4px; font-size: 14px;" %>
          <%= f.date_field :saved_at, value: Date.today, style: "width: 100%; padding: 8px; border: 1px solid #ffe6f2; border-radius: 8px; box-sizing: border-box;" %>
        </div>

        <!-- メモフィールド ＋ datalist -->
        <div style="margin-bottom: 16px;">
          <%= f.label :memo, "メモ (任意)", style: "display: block; font-weight: bold; margin-bottom: 4px; font-size: 14px;" %>
          
          <!-- list属性で下の datalist と紐付ける（※text_fieldに変更するとスムーズです） -->
          <%= f.text_field :memo, placeholder: "お小遣いから、など", list: "memo-options", style: "width: 100%; padding: 8px; border: 1px solid #ffe6f2; border-radius: 8px; box-sizing: border-box;" %>
          
          <!-- 過去のメモの候補リスト -->
          <% if @existing_memos.present? %>
            <datalist id="memo-options">
              <% @existing_memos.each do |memo| %>
                <option value="<%= memo %>">
              <% end %>
            </datalist>
          <% end %>
        </div>

        <div>
          <%= f.submit "貯金を記録する", style: "background: #ff99bb; color: white; border: none; padding: 10px 20px; border-radius: 12px; font-weight: bold; cursor: pointer; width: 100%;" %>
        </div>
      <% end %>
    </div>

    <!-- 貯金履歴の一覧 -->
    <div style="margin-bottom: 24px; color: #6d5b71;">
      <h3 style="color: #6d5b71; font-size: 18px;">🌱 貯金履歴</h3>
      <% if @wish.savings.any? %>
        <ul style="padding-left: 20px; margin: 0;">
          <% @wish.savings.order(saved_at: :desc).each do |saving| %>
            <li style="margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong><%= saving.saved_at.strftime("%Y年%m月%d日") %></strong>：
                <span style="color: #d87093; font-weight: bold;">¥<%= number_to_currency(saving.amount, unit: "", precision: 0) %></span>
                <% if saving.memo.present? %>
                  （<%= saving.memo %>）
                <% end %>
              </div>
              
              <!-- 💡 編集ボタンとゴミ箱削除ボタンを横に並べるエリア -->
              <div style="display: flex; gap: 6px; align-items: center;">
                <%= link_to "編集", edit_wish_saving_path(@wish, saving), style: "background: #ffe6f2; color: #6d5b71; padding: 4px 10px; border-radius: 10px; text-decoration: none; font-size: 12px; font-weight: bold;" %>
                
                <%= button_to "削除", wish_saving_path(@wish, saving), method: :delete, data: { turbo_confirm: "本当にこの貯金記録を削除しますか？" }, style: "background: #fff0f5; color: #d87093; border: 1px solid #ffb6c1; padding: 4px 8px; border-radius: 10px; font-size: 12px; font-weight: bold; cursor: pointer;" %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p style="font-size: 14px; color: #999;">まだ貯金履歴はありません。</p>
      <% end %>
    </div>
    
    <!-- 下部のボタンエリア -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
      <%= link_to "← 一覧に戻る", wishes_path, style: "color: #ff99bb; text-decoration: none; font-weight: bold;" %>
      
      <div style="display: flex; gap: 10px; align-items: center;">
        <%= link_to "✏️ 編集する", edit_wish_path(@wish), style: "background: #ffe6f2; color: #6d5b71; padding: 8px 16px; border-radius: 15px; text-decoration: none; font-weight: bold; font-size: 14px;" %>
        
        <%= button_to "🗑️ 削除する", wish_path(@wish), method: :delete, data: { turbo_confirm: "本当にこの叶えたいこと・欲しいものを削除しますか？" }, style: "background: #fff0f5; color: #d87093; border: 1px solid #ffb6c1; padding: 8px 16px; border-radius: 15px; font-weight: bold; font-size: 14px; cursor: pointer;" %>
      </div>
    </div>

  </div>
</div>