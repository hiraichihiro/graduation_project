<div style="max-width: 600px; margin: 40px auto; padding: 24px; font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', sans-serif;">
  <h2 style="color: #6d5b71; text-align: center; margin-bottom: 24px; font-weight: 700;">💌 叶えたいこと・欲しいもの 💌</h2>

  <div style="text-align: right; margin-bottom: 20px;">
    <%= link_to "＋ 新しく登録する", new_wish_path, style: "background: #ffb6c1; color: white; padding: 10px 18px; border-radius: 20px; text-decoration: none; font-weight: bold; font-size: 14px; box-shadow: 0 4px 10px rgba(255, 182, 193, 0.4);" %>
  </div>

  <% if @wishes.any? %>
    <% @wishes.each do |wish| %>
      <%= link_to wish_path(wish), style: "text-decoration: none; color: inherit; display: block; margin-bottom: 16px;" do %>
        <div style="background: #fffcfd; border: 1.5px solid #ffe6f2; border-radius: 20px; padding: 20px; box-shadow: 0 4px 15px rgba(255,182,193,0.15);">
          
          <% if wish.image.attached? %>
            <div style="text-align: center; margin-bottom: 15px;">
              <%= image_tag wish.image, style: "max-width: 100%; max-height: 200px; border-radius: 12px; object-fit: cover;" %>
            </div>
          <% end %>

          <h3 style="color: #6d5b71; margin-top: 0; margin-bottom: 12px; font-size: 18px;"><%= wish.title %></h3>
          
          <% if wish.target_amount.present? %>
            <p style="color: #8a7b8e; margin: 6px 0; font-size: 14px;">
              💰 目標金額: <strong>¥<%= number_to_currency(wish.target_amount, unit: "", precision: 0) %></strong>
            </p>
            <p style="color: #8a7b8e; margin: 6px 0; font-size: 14px;">
              🌱 貯金済額: <strong>¥<%= number_to_currency(wish.total_saved, unit: "", precision: 0) %></strong>
              （あと: <strong>¥<%= number_to_currency(wish.remaining_amount, unit: "", precision: 0) %></strong>）
            </p>
          <% end %>

          <% if wish.deadline.present? %>
            <p style="color: #8a7b8e; margin: 6px 0; font-size: 14px;">
              📅 目標期限: <%= wish.deadline.strftime("%Y年%m月%d日") %>
            </p>
          <% end %>

          <%# 🌸 水色ベースに白文字の日割り計算の表示エリア %>
          <% if wish.daily_savings_target.present? %>
            <div style="margin-top: 12px; font-size: 13px; color: #ffffff; background: #9be0ff; padding: 10px 14px; border-radius: 14px; font-weight: bold; text-align: center; border: 1.5px solid #e0f5ff; box-shadow: 0 4px 12px rgba(155, 224, 255, 0.4);">
            ⏰期限まであと <%= wish.remaining_days %> 日！ 1日あたり <strong>¥<%= number_to_currency(wish.daily_savings_target, unit: "", precision: 0) %></strong> 貯金しよう！
            </div>
          <% end %>

          <%# 🌈 パステルレインボーの進捗率バーエリア %>
          <% if wish.target_amount.present? %>
            <div style="margin-top: 12px;">
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: bold; margin-bottom: 4px;">
                <span style="color: #6d5b71;">進捗率</span>
                <span style="background: linear-gradient(90deg, #ff9a9e, #fecfef, #a1c4fd, #c2e9fb); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; font-size: 15px;">
                  <%= wish.progress_percentage %>%
                </span>
              </div>
              <div style="width: 100%; background-color: #fff0f5; border-radius: 10px; height: 12px; overflow: hidden; border: 1.5px solid #ffe6f2;">
                <div style="width: <%= wish.progress_percentage %>%; height: 100%; background: linear-gradient(90deg, #ffb3ba, #ffdfba, #ffffba, #baffc9, #bae1ff); border-radius: 10px; transition: width 0.5s ease-in-out;"></div>
              </div>
            </div>
          <% end %>

          <% if wish.link_url.present? %>
            <p style="color: #8a7b8e; margin: 6px 0; font-size: 14px;">
              🔗 リンクあり
            </p>
          <% end %>

          <% if wish.memo.present? %>
            <p style="color: #8a7b8e; margin: 6px 0; font-size: 14px; background: #fff5f8; padding: 10px; border-radius: 10px;">
              📝 <%= wish.memo %>
            </p>
          <% end %>

        </div>
      <% end %>
    <% end %>
  <% else %>
    <div style="text-align: center; padding: 40px; color: #8a7b8e; background: #fffcfd; border: 1.5px dashed #ffe6f2; border-radius: 20px;">
      <p style="margin: 0;">まだ「叶えたいこと」が登録されていません🫧</p>
    </div>
  <% end %>
</div>