<div class="max-w-md mx-auto my-10 p-6 bg-white rounded-lg shadow-md">
  <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">ログイン</h1>

  <%= form_with(url: login_path, scope: :session, local: true) do |f| %>
    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block text-gray-700 text-sm font-bold mb-2" %>
      <%= f.email_field :email, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-300" %>
    </div>

    <div class="mb-6">
      <%= f.label :password, "パスワード", class: "block text-gray-700 text-sm font-bold mb-2" %>
      <%= f.password_field :password, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-300" %>
    </div>

    <div class="mb-4">
      <%= f.submit "ログイン", class: "w-full bg-pink-400 text-white font-bold py-2 px-4 rounded-lg hover:bg-pink-500 cursor-pointer transition" %>
    </div>
  <% end %>

  <div class="text-center mt-4">
    <%= link_to "新規登録はこちら", signup_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
</div>