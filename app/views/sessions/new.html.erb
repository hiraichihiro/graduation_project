<div style="max-width: 420px; margin: 40px auto; padding: 30px 24px; background-color: #ffffff; border-radius: 24px; box-shadow: 0 10px 25px rgba(255, 182, 193, 0.2); border: 2px solid #ffe6f2; text-align: center;">

  <h2 style="font-size: 1.5rem; color: #ff8fa3; font-weight: bold; margin-bottom: 24px;">
    🫧 ログイン 🫧
  </h2>

  <%= form_with url: login_path, scope: :session, local: true do |f| %>
    <div style="margin-bottom: 20px; text-align: left;">
      <%= f.label :email, "メールアドレス", style: "display: block; font-size: 0.875rem; color: #8c7888; font-weight: bold; margin-bottom: 6px;" %>
      <%= f.email_field :email, placeholder: "example@example.com", style: "width: 100%; padding: 10px 14px; border: 1.5px solid #ffd1dc; border-radius: 12px; font-size: 0.95rem; outline: none; background-color: #fffafc; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 24px; text-align: left;">
      <%= f.label :password, "パスワード", style: "display: block; font-size: 0.875rem; color: #8c7888; font-weight: bold; margin-bottom: 6px;" %>
      <%= f.password_field :password, style: "width: 100%; padding: 10px 14px; border: 1.5px solid #ffd1dc; border-radius: 12px; font-size: 0.95rem; outline: none; background-color: #fffafc; box-sizing: border-box;" %>
    </div>

    <div>
      <%= f.submit "ログイン", style: "width: 100%; background-color: #ffb6c1; color: white; padding: 12px; border-radius: 20px; font-weight: bold; font-size: 1rem; border: none; cursor: pointer; box-shadow: 0 4px 12px rgba(255, 182, 193, 0.4); transition: all 0.2s;" %>
    </div>
  <% end %>

  <div style="margin-top: 20px;">
    <%= link_to "新規登録はこちら", signup_path, style: "color: #ff8fa3; font-size: 0.875rem; text-decoration: none; font-weight: bold;" %>
  </div>

</div>