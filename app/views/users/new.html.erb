<div style="max-width: 500px; margin: 40px auto; padding: 35px 30px; background: #ffffff; border-radius: 28px; border: 2.5px solid #ffe6f2; box-shadow: 0 8px 24px rgba(255, 179, 217, 0.2);">
  
  <!-- タイトル -->
  <h2 style="font-size: 1.5rem; color: #ff80bf; margin-top: 0; margin-bottom: 25px; text-align: center; font-weight: 800; letter-spacing: 0.5px;">
    ✏️ 新規登録
  </h2>

  <%= form_with(model: @user, local: true) do |f| %>
    
    <!-- エラーメッセージ表示 -->
    <% if @user.errors.any? %>
      <div style="background: #fff0f5; border: 1.5px solid #ffb3d9; color: #ff66b2; padding: 12px 16px; border-radius: 14px; font-size: 0.9rem; font-weight: 700; margin-bottom: 20px;">
        <ul style="margin: 0; padding-left: 20px;">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- name -->
    <div style="margin-bottom: 18px;">
      <%= f.label :name, "name", style: "font-weight: 700; color: #8a7b8e; display: block; margin-bottom: 6px; font-size: 0.95rem;" %>
      <%= f.text_field :name, required: true, style: "width: 100%; border-radius: 14px; border: 1.5px solid #ffe6f2; padding: 10px 14px; background: #fffcfd; color: #8a7b8e; font-family: inherit; font-size: 0.95rem; box-sizing: border-box;" %>
    </div>

    <!-- Email -->
    <div style="margin-bottom: 18px;">
      <%= f.label :email, "Email", style: "font-weight: 700; color: #8a7b8e; display: block; margin-bottom: 6px; font-size: 0.95rem;" %>
      <%= f.email_field :email, required: true, style: "width: 100%; border-radius: 14px; border: 1.5px solid #ffe6f2; padding: 10px 14px; background: #fffcfd; color: #8a7b8e; font-family: inherit; font-size: 0.95rem; box-sizing: border-box;" %>
    </div>

    <!-- password -->
    <div style="margin-bottom: 18px;">
      <%= f.label :password, "password", style: "font-weight: 700; color: #8a7b8e; display: block; margin-bottom: 6px; font-size: 0.95rem;" %>
      <%= f.password_field :password, required: true, style: "width: 100%; border-radius: 14px; border: 1.5px solid #ffe6f2; padding: 10px 14px; background: #fffcfd; color: #8a7b8e; font-family: inherit; font-size: 0.95rem; box-sizing: border-box;" %>
    </div>

    <!-- password Confirmation -->
    <div style="margin-bottom: 25px;">
      <%= f.label :password_confirmation, "password Confirmation", style: "font-weight: 700; color: #8a7b8e; display: block; margin-bottom: 6px; font-size: 0.95rem;" %>
      <%= f.password_field :password_confirmation, required: true, style: "width: 100%; border-radius: 14px; border: 1.5px solid #ffe6f2; padding: 10px 14px; background: #fffcfd; color: #8a7b8e; font-family: inherit; font-size: 0.95rem; box-sizing: border-box;" %>
    </div>

    <!-- 登録ボタン -->
    <div style="margin-bottom: 20px;">
      <%= f.submit "登録", style: "width: 100%; border-radius: 25px; font-weight: 800; padding: 12px; background: #ffb3d9; border: none; font-size: 1rem; color: #ffffff; cursor: pointer; box-shadow: 0 4px 12px rgba(255, 179, 217, 0.4); font-family: inherit;" %>
    </div>

  <% end %>

  <!-- 遷移図に沿った各種リンクエリア -->
  <div style="text-align: center; margin-top: 15px; font-size: 0.9rem;">
    <p style="color: #8a7b8e; margin-bottom: 8px; font-weight: 700;">アカウントをお持ちの方はこちら</p>
    <div style="margin-bottom: 15px;">
      <%= link_to 'ログイン', '#', style: "color: #ff80bf; text-decoration: none; font-weight: 700; background: #fff0f5; padding: 6px 20px; border-radius: 15px; display: inline-block; border: 1px solid #ffd1e8;" %>
    </div>

    <p style="color: #8a7b8e; margin-bottom: 8px; font-weight: 700;">※会員登録なしですぐにご利用いただけます</p>
    <div>
      <%= link_to 'ゲストログイン（お試しはこちら）', '#', style: "color: #70d6ff; text-decoration: none; font-weight: 700; background: #f0faff; padding: 6px 20px; border-radius: 15px; display: inline-block; border: 1px solid #cceeff;" %>
    </div>
  </div>

</div>