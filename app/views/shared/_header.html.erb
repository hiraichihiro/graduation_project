<header class="bg-white shadow-sm mb-4 py-3 px-4" style="border-bottom: 2px dashed #ffe6f2;">
  <div class="container mx-auto flex justify-between items-center">
    <!-- ロゴ・アプリ名 -->
    <% if logged_in? %>
      <%= link_to "Yumelist", wishes_path, class: "text-xl font-bold", style: "color: #ff8fa3;" %>
    <% else %>
      <%= link_to "Yumelist", root_path, class: "text-xl font-bold", style: "color: #ff8fa3;" %>
    <% end %>

    <!-- 認証状態に応じたボタン表示 -->
    <nav class="flex items-center space-x-4">
      <% if logged_in? %>
        <!-- ✨ 挨拶を一番左に移動！ -->
        <span class="text-sm" style="color: #8c7888;">こんにちは、<%= current_user.name %>さん</span>
        
        <span class="text-sm text-gray-300">|</span>
        
        <%= link_to "叶えたいこと", wishes_path, class: "text-sm font-medium", style: "color: #8c7888;" %>
        <%= link_to "叶ったこと", fulfilled_wishes_path, class: "text-sm font-medium", style: "color: #8c7888;" %>
        
        <%= button_to "ログアウト", logout_path, method: :delete, class: "text-sm cursor-pointer", style: "color: #8c7888; background: none; border: none; padding: 0;" %>
      <% else %>
        <%= link_to "ゲストログイン", users_guest_sign_in_path, data: { turbo_method: :post }, class: "text-sm text-pink-500 hover:text-pink-600 font-medium" %>
        <%= link_to "ログイン", login_path, class: "text-sm", style: "color: #8c7888;" %>
        <%= link_to "新規登録", signup_path, class: "text-sm text-white px-3 py-1.5 rounded-lg transition", style: "background-color: #ffb6c1;" %>
      <% end %>
    </nav>
  </div>
</header>